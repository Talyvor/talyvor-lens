LENS_LISTEN_ADDR=0.0.0.0:8080
LENS_REDIS_URL=redis://localhost:6379
LENS_DATABASE_URL=postgres://lens:localdev@localhost:5432/talyvor_lens?sslmode=disable
LENS_NATS_URL=nats://localhost:4222
LENS_OPENAI_API_KEY=sk-...
LENS_ANTHROPIC_API_KEY=sk-ant-...
LENS_GOOGLE_API_KEY=AIza...
LENS_EMBEDDING_MODEL=text-embedding-3-small
LENS_SEMANTIC_THRESHOLD=0.98
LENS_MAX_CACHE_TTL=24h
LENS_LOG_LEVEL=info
LENS_OLLAMA_URL=http://localhost:11434
LENS_AWS_REGION=us-east-1
LENS_AWS_ACCESS_KEY_ID=AKIA...
LENS_AWS_SECRET_ACCESS_KEY=...
LENS_AWS_SESSION_TOKEN=  # optional, for assumed roles / STS creds
LENS_MISTRAL_API_KEY=
LENS_GROQ_API_KEY=
LENS_VLLM_BASE_URL=http://localhost:8000
LENS_VLLM_API_KEY=  # optional

# Require a REAL-money (livemode) purchase before a workspace may EARN. Default false so a
# TEST-key trial works: a test purchase records livemode=false and still earn-verifies.
# ⚠ SET THIS TRUE BEFORE OPEN SIGNUP — otherwise anyone who can reach checkout mints
# themselves earning rights for free with a test card.
# LENS_EARN_REQUIRE_LIVE_PURCHASE=false

# ─── FULL CONFIGURATION SURFACE ──────────────────────────────────────────────
#
# Every remaining variable internal/config reads, listed so the set is
# DISCOVERABLE rather than folklore. It used to be implicit in docker-compose.yaml's
# environment: list — but that list was also what made a variable reach the process,
# so forgetting an entry silently disabled the feature instead of merely
# under-documenting it. The compose file now passes .env through wholesale, and this
# section carries the documentation on its own. cmd/lens/compose_env_mechanism_test.go
# fails if config grows a variable that is not listed here.
#
# All are commented out: each has a default in internal/config. Uncomment to override.
# Defaults are authoritative in internal/config — this file names the knobs, not their values.
#
# LENS_ADMIN_LXC_GRANT_ENABLED=
# LENS_ANNOTATION_MINTING_ENABLED=
